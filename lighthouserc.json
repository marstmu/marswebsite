{
  "ci": {
    "collect": {
      "url": [
        "http://localhost/",
        "http://localhost/gallery/",
        "http://localhost/blog/2024/09/16/kickoff-meeting/"
      ],
      "numberOfRuns": 2,
      "settings": { "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.75, "aggregationMethod": "median" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:seo": ["error", { "minScore": 0.90, "aggregationMethod": "median" }]
      }
    }
  }
}
